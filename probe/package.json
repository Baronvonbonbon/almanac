{
  "name": "almanac-probe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "almanac Phase 0 — measures the Polkadot app platform on a real device before almanac builds on it",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy-key": "node scripts/deploy-key.mjs",
    "pad:login": "npx --yes @polkadot-community-foundation/polkadot-app-deploy@0.16.1 login --env devnet",
    "pad:logout": "npx --yes @polkadot-community-foundation/polkadot-app-deploy@0.16.1 logout --env devnet",
    "pad:whoami": "npx --yes @polkadot-community-foundation/polkadot-app-deploy@0.16.1 whoami --env devnet"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@parity/product-sdk": "0.27.0",
    "@parity/product-sdk-crypto": "0.1.1",
    "@parity/product-sdk-host": "0.19.1",
    "@parity/product-sdk-keys": "0.3.24"
  },
  "devDependencies": {
    "@polkadot-labs/hdkd": "0.0.28",
    "@polkadot-labs/hdkd-helpers": "0.0.30",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
